# Set your own provider credentials. Never commit the local .env file.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Select anthropic or openai and the exact model ID available to your account.
# A model is required when model-assisted stages are enabled; no model is preselected.
# CLI flags override task configuration; configuration overrides these values.
LLM_PROVIDER=
LLM_MODEL=

# Optional tracing.
ENABLE_LANGSMITH_TRACE=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional explicit paths for evidence-pipeline browser/OCR tools.
# See docs/runtime.md for setup and the local acquisition-paths.json file.
CHROMIUM_EXECUTABLE=
TESSERACT_EXECUTABLE=
TESSDATA_DIR=
